{
  "name": "dsh-workbuddy-connect-community",
  "displayName": "DSH WorkBuddy Connect Community",
  "description": "Community-maintained WorkBuddy / WorkBuddy AI provider for DeepSeek Harness.",
  "version": "0.1.19",
  "author": "Tang Yixiao (maintained fork of Corrine Hu's dsh-workbuddy-connect)",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "workbuddy",
    "model-provider"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.5 || 0.2.2-rc.1"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-workbuddy-connect-community": "lib/bin.js"
  },
  "scripts": {
    "prepack": "pnpm run build && pnpm run check-release",
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "check-release": "node scripts/check-release.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run check-release"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./assets/logo.webp"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt",
    "assets/logo.webp",
    "assets/NOTICE.md",
    "assets/LICENSE-WHALE-ARTWORK",
    "docs",
    "CONTRIBUTING.md",
    "SUPPORT.md",
    "SECURITY.md",
    "AGENTS.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangyixiao/dsh-workbuddy-connect-community.git"
  },
  "homepage": "https://github.com/tangyixiao/dsh-workbuddy-connect-community#readme",
  "bugs": "https://github.com/tangyixiao/dsh-workbuddy-connect-community/issues",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cordis-plugin-group": "~1.1.0",
    "@deepseek-ai/cordis-plugin-include": "~1.1.0",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-authorization": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@earendil-works/pi-ai": "1.5.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "@types/react-test-renderer": "^18.3.1",
    "@types/semver": "^7.8.0",
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "react-test-renderer": "18.3.1",
    "semver": "^7.8.5",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "icon": "./assets/logo.webp"
}
